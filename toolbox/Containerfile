# Toolbx image: UBI 9 + OpenCode + Plannotator (CLI + OpenCode plugin).
#
# Everything is installed system-wide (no $HOME). OpenCode reads its
# system config from /etc/opencode (see etc-opencode/ in this directory).
#
# Build:  podman build -t opencode-toolbox -f Containerfile .
# Use:    toolbox create --image localhost/opencode-toolbox opencode && toolbox enter opencode

ARG BASE_IMAGE=registry.access.redhat.com/ubi9/toolbox:latest
FROM ${BASE_IMAGE}

ARG NODEJS_STREAM=24
ARG OPENCODE_VERSION=1.19.5
ARG PLANNOTATOR_VERSION=0.28.38
# sha256 of the GitHub release assets plannotator-linux-{x64,arm64} for
# PLANNOTATOR_VERSION. Update together with the version.
ARG PLANNOTATOR_SHA256_X64=0e0cbeaded05eee864e781abcf97c2cfa47babf895cf81e4ad0bd900d86f4a82
ARG PLANNOTATOR_SHA256_ARM64=2d67740ebaf4d58edbba3190b53dba888943a5a72751e09598e6218701194943

LABEL com.github.containers.toolbox="true" \
      name="opencode-toolbox" \
      summary="UBI 9 Toolbx image with OpenCode and Plannotator" \
      org.opencontainers.image.description="UBI 9 Toolbx image with OpenCode and Plannotator installed system-wide"

# Node.js (for npm) from the UBI AppStream module stream.
RUN dnf -y module enable nodejs:${NODEJS_STREAM} \
 && dnf -y install nodejs npm \
 && dnf clean all \
 && rm -rf /var/cache/dnf

# npm global prefix is /usr/local: binaries in /usr/local/bin, packages in
# /usr/local/lib/node_modules. Nothing is written under /root.
ENV NPM_CONFIG_PREFIX=/usr/local \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

# OpenCode. Its postinstall only links the platform binary from the matching
# opencode-linux-* optional dependency, so scripts are left enabled here.
RUN set -eu; \
    npm install --global --cache /tmp/npm-cache "opencode-ai@${OPENCODE_VERSION}"; \
    rm -rf /tmp/npm-cache; \
    opencode --version; \
    # opencode --version creates per-user dirs under $HOME; drop them.
    rm -rf /root/.cache/opencode /root/.config/opencode \
           /root/.local/share/opencode /root/.local/state/opencode; \
    for d in /root/.cache /root/.config /root/.local/share /root/.local/state /root/.local; do \
      rmdir "$d" 2>/dev/null || :; \
    done

# Plannotator OpenCode plugin. --ignore-scripts: its postinstall would copy
# the command stubs and skill into ~/.config/opencode of the build user; we
# copy the same files into /etc/opencode explicitly below instead.
RUN npm install --global --ignore-scripts --cache /tmp/npm-cache "@plannotator/opencode@${PLANNOTATOR_VERSION}" \
 && rm -rf /tmp/npm-cache

# Plannotator CLI: the release binary straight from GitHub, checked against
# the pinned sha256. This is the same asset the upstream install.sh fetches.
RUN set -eu; \
    case "$(uname -m)" in \
      x86_64|amd64)  arch=x64;   sha="${PLANNOTATOR_SHA256_X64}" ;; \
      aarch64|arm64) arch=arm64; sha="${PLANNOTATOR_SHA256_ARM64}" ;; \
      *) echo "unsupported arch $(uname -m)" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/backnotprop/plannotator/releases/download/v${PLANNOTATOR_VERSION}/plannotator-linux-${arch}"; \
    curl -fsSL --retry 3 -o /tmp/plannotator "$url"; \
    echo "${sha}  /tmp/plannotator" | sha256sum -c -; \
    install -m 0755 /tmp/plannotator /usr/local/bin/plannotator; \
    rm -f /tmp/plannotator

# System-wide OpenCode config. /etc/opencode is OpenCode's managed config
# directory on Linux (opencode.json there is always loaded). OPENCODE_CONFIG_DIR
# additionally makes OpenCode load commands/, skills/ and plugins/ from it.
COPY etc-opencode/ /etc/opencode/
RUN set -eu; \
    pkg=/usr/local/lib/node_modules/@plannotator/opencode; \
    mkdir -p /etc/opencode/commands /etc/opencode/skills; \
    cp "$pkg"/commands/*.md /etc/opencode/commands/; \
    cp -R "$pkg"/skills/plannotator /etc/opencode/skills/; \
    chmod -R a+rX /etc/opencode
# Set both as image ENV and in profile.d so login shells (e.g. toolbox enter)
# get it even if the container environment is not passed through.
COPY etc-profile.d-opencode.sh /etc/profile.d/opencode.sh
ENV OPENCODE_CONFIG_DIR=/etc/opencode
